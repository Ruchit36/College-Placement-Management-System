@model CollegePlacementManagementSystem.Models.Company

@{
    ViewData["Title"] = "Delete Company";
}

<h1>Delete Company</h1>

<h3>Are you sure you want to delete this company?</h3>

<div>
    <p><strong>Company Name:</strong> @Model.CompanyName</p>
    <p><strong>Industry:</strong> @Model.Industry</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Location:</strong> @Model.Location</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>

</form>
