@model CollegePlacementManagementSystem.Models.StudentRegisterViewModel

@{
    ViewData["Title"] = "Student Registration";
    Layout = "_Layout";
}

<div class="container d-flex justify-content-center align-items-center py-5">

    <div class="card shadow-lg border-0" style="width: 100%; max-width: 480px; border-radius: 15px;">

        <div class="card-header text-center text-white py-4"
             style="background-color: #123B5D; border-radius: 15px 15px 0 0;">

            <h3 class="mb-1">Student Registration</h3>
            <p class="mb-0">College Placement Management System</p>

        </div>

        <div class="card-body p-4">

            <div class="text-center mb-4">

                <div style="font-size: 45px; color: #0F766E;">
                    <i class="bi bi-person-plus-fill"></i>
                </div>

                <h5 class="mt-2">Create Your Account</h5>

                <p class="text-muted">
                    Register using your existing student details.
                </p>

            </div>

            <form asp-controller="Account" asp-action="Register" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="StudentId" class="form-label fw-semibold">
                        Student ID
                    </label>

                    <input asp-for="StudentId" class="form-control" type="number" placeholder="Enter your Student ID" />

                    <span asp-validation-for="StudentId" class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Email" class="form-label fw-semibold">
                        Registered Email
                    </label>

                    <input asp-for="Email" class="form-control" type="email"
                           placeholder="Enter your registered email" />

                    <span asp-validation-for="Email" class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Password" class="form-label fw-semibold">
                        Password
                    </label>

                    <input asp-for="Password" class="form-control" placeholder="Create a password" />

                    <span asp-validation-for="Password" class="text-danger">
                    </span>

                </div>

                <div class="mb-4">

                    <label asp-for="ConfirmPassword" class="form-label fw-semibold">
                        Confirm Password
                    </label>

                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm your password" />

                    <span asp-validation-for="ConfirmPassword" class="text-danger">
                    </span>

                </div>

                <button type="submit" class="btn btn-primary w-100 py-2"
                        style="background-color: #0F766E; border-color: #0F766E;">

                    <i class="bi bi-person-check me-1"></i>
                    Create Account

                </button>

            </form>

            <div class="text-center mt-4">

                <span class="text-muted">Already have an account?</span>

                <a asp-controller="Account" asp-action="Login" class="fw-semibold text-decoration-none"
                   style="color: #0F766E;">
                    Login
                </a>

            </div>

        </div>

        <div class="card-footer text-center text-muted py-3">
            <small>College Placement Management System</small>
        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
