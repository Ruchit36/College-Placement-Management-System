@model CollegePlacementManagementSystem.Models.Student

@using CollegePlacementManagementSystem.Models

@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "_Layout";

    var drives = ViewBag.PlacementDrives as List<PlacementDrive>
                 ?? new List<PlacementDrive>();
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="container py-4">

    <div class="p-4 mb-4 text-white rounded-3 shadow-sm" style="background-color: #123B5D;">

        <h2 class="mb-2">
            Welcome, @Model.FullName!
        </h2>

        <p class="mb-0">
            Explore placement opportunities and manage your career journey.
        </p>

    </div>

    <!-- Student Profile -->

    <h4 class="mb-3" style="color: #123B5D;">
        My Profile
    </h4>

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <strong>Student ID:</strong>
                    <span>@Model.Id</span>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Full Name:</strong>
                    <span>@Model.FullName</span>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Email:</strong>
                    <span>@Model.Email</span>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Course:</strong>
                    <span>@Model.Course</span>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>CGPA:</strong>
                    <span>@Model.CGPA</span>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Graduation Year:</strong>
                    <span>@Model.GraduationYear</span>
                </div>

            </div>

        </div>

    </div>

    <!-- Available Placement Opportunities -->

    <h4 class="mb-3" style="color: #123B5D;">
        Available Placement Opportunities
    </h4>

    @if (drives.Any())
    {
        <div class="card shadow-sm border-0 mb-4">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead style="background-color: #123B5D; color: white;">

                        <tr>
                            <th>Company</th>
                            <th>Job Role</th>
                            <th>Minimum CGPA</th>
                            <th>Application Deadline</th>
                            <th>Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var drive in drives)
                        {
                            <tr>

                                <td>@drive.CompanyName</td>

                                <td>@drive.JobRole</td>

                                <td>@drive.MinimumCGPA</td>

                                <td>
                                    @drive.ApplicationDeadline.ToString("dd MMM yyyy")
                                </td>

                                <td>

                                    @if (drive.ApplicationDeadline.Date >= DateTime.Today)
                                    {
                                        <form asp-controller="StudentDashboard" asp-action="Apply" asp-route-id="@drive.Id"
                                              method="post">

                                            <button type="submit" class="btn btn-success btn-sm">
                                                Apply Now
                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary btn-sm" disabled>
                                            Deadline Passed
                                        </button>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }
    else
    {
        <div class="alert alert-info">
            No eligible placement opportunities are currently available.
        </div>
    }

    <!-- My Applications -->

    <h4 class="mb-3 mt-4" style="color: #123B5D;">
        My Applications
    </h4>

    @{
        var myApplications = ViewBag.MyApplications
            as List<PlacementApplication>
            ?? new List<PlacementApplication>();
    }

    @if (myApplications.Any())
    {
        <div class="card shadow-sm border-0 mb-4">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead style="background-color: #123B5D; color: white;">
                        <tr>
                            <th>Company</th>
                            <th>Job Role</th>
                            <th>Application Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var application in myApplications)
                        {
                            <tr>
                                <td>@application.CompanyName</td>

                                <td>@application.JobRole</td>

                                <td>
                                    @application.ApplicationDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @if (application.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                    else if (application.Status == "Shortlisted")
                                    {
                                        <span class="badge bg-success">
                                            Shortlisted
                                        </span>
                                    }
                                    else if (application.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger">
                                            Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @application.Status
                                        </span>
                                    }
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }
    else
    {
        <div class="alert alert-info">
            You have not submitted any placement applications yet.
        </div>
    }

    <!-- Logout -->

    <div class="mt-4 mb-4">

        <form asp-controller="Account" asp-action="Logout" method="post">

            <button type="submit" class="btn btn-danger">
                <i class="bi bi-box-arrow-right me-1"></i>
                Logout
            </button>

        </form>

    </div>

</div>