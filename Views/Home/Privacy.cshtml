@{
    ViewData["Title"] = "Privacy";
}

<div class="container mt-4 mb-4">

    <div class="card p-4">

        <h1>Privacy & Data Use</h1>

        <p class="mt-3">
            The College Placement Management System is an academic
            project developed to demonstrate the management of
            student records, companies, placement drives and
            placement applications.
        </p>

        <hr />

        <h5>1. Information Collected</h5>

        <p>
            The system stores information entered by users, including
            student names, email addresses, courses, CGPA, company
            details and placement application records.
        </p>

        <h5>2. Purpose of Information</h5>

        <p>
            The information is used to demonstrate student management,
            company management, placement drive management and
            application tracking.
        </p>

        <h5>3. Database Storage</h5>

        <p>
            The application stores submitted records in its configured
            SQL Server database.
        </p>

        <h5>4. Academic Project Notice</h5>

        <p>
            This system is developed for educational and demonstration
            purposes. It is not intended to replace a production-ready
            placement management platform.
        </p>

        <hr />

        <p class="text-muted mb-0">
            College Placement Management System
        </p>

    </div>

</div>