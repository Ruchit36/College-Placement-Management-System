@model CollegePlacementManagementSystem.Models.PlacementDrive

@{
    ViewData["Title"] = "Delete Placement Drive";
}

<h1>Delete Placement Drive</h1>

<h3>Are you sure you want to delete this placement drive?</h3>

<div>
    <p><strong>Company Name:</strong> @Model.CompanyName</p>
    <p><strong>Job Role:</strong> @Model.JobRole</p>
    <p><strong>Minimum CGPA:</strong> @Model.MinimumCGPA</p>
    <p><strong>Application Deadline:</strong> @Model.ApplicationDeadline.ToString("dd-MM-yyyy")</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>

</form>
