@model CollegePlacementManagementSystem.Models.PlacementDrive

@{
    ViewData["Title"] = "Edit Placement Drive";
}

<h1>Edit Placement Drive</h1>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <div class="form-group mb-3">
        <label asp-for="CompanyName" class="control-label">Company Name</label>
        <input asp-for="CompanyName" class="form-control" />
        <span asp-validation-for="CompanyName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="JobRole" class="control-label">Job Role</label>
        <input asp-for="JobRole" class="form-control" />
        <span asp-validation-for="JobRole" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="MinimumCGPA" class="control-label">Minimum CGPA</label>
        <input asp-for="MinimumCGPA" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="MinimumCGPA" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ApplicationDeadline" class="control-label">Application Deadline</label>
        <input asp-for="ApplicationDeadline" class="form-control" type="date" />
        <span asp-validation-for="ApplicationDeadline" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
